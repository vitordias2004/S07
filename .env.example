# ─── E-mail (credenciais do Jenkins) ───────────────────────────────────────
# E-mail que envia as notificações do pipeline
EMAIL_REMETENTE=seuemail@gmail.com

# E-mail que recebe as notificações do pipeline
EMAIL_DESTINO=destino@gmail.com

# Senha de app do Gmail (não a senha da conta Google)
# Como gerar: Conta Google → Segurança → Verificação em duas etapas → Senhas de app
EMAIL_SENHA=sua-senha-de-app-16-caracteres

# ─── Docker Hub ────────────────────────────────────────────────────────────
# Usuário do Docker Hub
DOCKER_HUB_USER=seu-usuario-dockerhub

# Token de acesso do Docker Hub (não a senha da conta)
# Como gerar: Docker Hub → Account Settings → Personal access tokens
DOCKER_HUB_TOKEN=seu-token-de-acesso

# ─── Cypress ───────────────────────────────────────────────────────────────

CYPRESS_BASE_URL=http://nginx:80